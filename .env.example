# ── Life OS v2 — Environment Variables ─────────────────────────────
# Copy this file to compose/.env and fill in your values.
# Defaults are shown for optional vars.

# ── Required ──────────────────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-char-string

# Postgres password for lifeos-user (embedded in DATABASE_URL)
LIFEOS_PASSWORD=change-me-to-a-strong-password

# ── Optional — defaults shown ─────────────────────────────────────

# Database name (default: lifeos)
# LIFEOS_DB=lifeos

# Database user (default: lifeos_user)
# LIFEOS_USER=lifeos_user

# Host-exposed ports (change if port conflicts)
# LIFEOS_DB_PORT=5434
# LIFEOS_NEST_PORT=4001
# LIFEOS_VUE_PORT=3002

# NestJS server port (internal, matches LIFEOS_NEST_PORT if proxied)
# PORT=4001

# Environment: development | production
# NODE_ENV=development

# Log level: debug | info | warn | error
# LOG_LEVEL=debug

# Comma-separated CORS origins (overrides NODE_ENV-based defaults)
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Full connection string (overrides individual DB vars if set)
# DATABASE_URL=postgres://lifeos_user:password@postgres:5432/lifeos

# ── n8n — Optional ────────────────────────────────────────────────

# Google Chat webhook URL for stack health alerts
# Create in Google Chat room → Apps & Integrations → Webhooks
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...

# ── OAuth2 Proxy (Google SSO) ─────────────────────────────────────
# Create OAuth 2.0 credentials at Google Cloud Console:
#   APIs & Services → Credentials → Create Credentials → OAuth client ID
#   Application type: Web application
#   Authorized redirect URIs (add all 6):
#     https://n8n.insightful-projects.com/oauth2/callback
#     https://code.insightful-projects.com/oauth2/callback
#     https://odysseus.insightful-projects.com/oauth2/callback
#     https://cloudbeaver.insightful-projects.com/oauth2/callback
#     https://grafana.insightful-projects.com/oauth2/callback
#     https://hub.insightful-projects.com/oauth2/callback
# Generate cookie secret: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# OAUTH2_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OAUTH2_GOOGLE_CLIENT_SECRET=your-client-secret
# OAUTH2_COOKIE_SECRET=your-generated-secret
# OAUTH2_COOKIE_SECURE=false  # set true once SSL is configured in NPM
