                                "type": "TextInput",
                                "label": "Loans",
                                "input-type": "number",
                                "required": true,
                                "name": "expense_loans",
                                "helper-text": "Total monthly loan repayment(s) in Rands"
                            },
                            {
                                "type": "TextInput",
                                "label": "Cell Phone Contract",
                                "input-type": "number",
