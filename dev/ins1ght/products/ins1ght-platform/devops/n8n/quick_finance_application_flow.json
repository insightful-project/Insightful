                            {
                                "type": "TextInput",
                                "label": "Period at Employer",
                                "input-type": "text",
                                "required": true,
                                "name": "period_at_employer",
                                "helper-text": "e.g. 3 years 6 months"
                            },
                            {
                                "type": "TextInput",
                                "label": "Work Telephone",
                                "input-type": "phone",
                                "required": false,
                                "name": "work_telephone",
                                "helper-text": "Office landline number (if available)"
                            }
                        ]
                    },
                    {
                        "type": "Footer",
                        "label": "Continue",
