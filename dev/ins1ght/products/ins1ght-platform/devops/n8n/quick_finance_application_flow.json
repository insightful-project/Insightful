                    },
                    {
                        "type": "Form",
                        "name": "financial_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "label": "Gross Salary",
                                "input-type": "number",
                                "required": true,
                                "name": "salary_gross",
                                "helper-text": "Enter amount in Rands, e.g. 25000"
                            },
                            {
                                "type": "TextInput",
                                "label": "Net Salary",
                                "input-type": "number",
                                "required": true,
                                "name": "salary_net",
                                "helper-text": "Enter amount in Rands, e.g. 18000"
                            },
                            {
                                "type": "TextInput",
                                "label": "Bond / Rent",
                                "input-type": "number",
                                "required": true,
                                "name": "expense_bond_rent",
                                "helper-text": "Monthly bond or rent payment in Rands (enter 0 if not applicable)"
                            },
                            {
                                "type": "TextInput",
                                "label": "Car Installments",
                                "input-type": "number",
                                "required": true,
                                "name": "expense_car",
