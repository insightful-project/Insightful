                                "name": "FINANCIAL_INFO"
                            },
                            "payload": {
                                "full_name": "${data.full_name}",
                                "id_number": "${data.id_number}",
                                "cell_phone": "${data.cell_phone}",
                                "email": "${data.email}",
                                "marital_status": "${data.marital_status}",
                                "date_married": "${data.date_married}",
                                "home_address": "${data.home_address}",
                                "period_at_address": "${data.period_at_address}",
                                "accommodation_type": "${data.accommodation_type}",
                                "kin_full_name": "${data.kin_full_name}",
                                "kin_address": "${data.kin_address}",
                                "kin_contact_number": "${data.kin_contact_number}",
                                "employer_name": "${form.employer_name}",
                                "employer_address": "${form.employer_address}",
                                "period_at_employer": "${form.period_at_employer}",
                                "work_telephone": "${form.work_telephone}"
                            }
                        }
