{
    "version": "7.1",
    "screens": [
        {
            "id": "WELCOME",
            "title": "Quick Finance Application",
            "terminal": false,
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Quick Finance Application"
                    },
                    {
                        "type": "TextBody",
                        "text": "Please complete this application and ensure you have the following documents ready to upload:\n\n• Clear copy of valid ID\n• Clear copy of valid Driver's Licence\n• 3 months payslips\n• 3 months bank statements\n• Proof of residence\n\nThis form will take approximately 5–10 minutes to complete."
                    },
                    {
                        "type": "TextBody",
                        "text": "All information provided is kept strictly confidential and used solely for the purpose of assessing your finance application."
                    },
                    {
                        "type": "Footer",
                        "label": "Start Application",
                        "on-click-action": {
                            "name": "navigate",
                            "next": {
                                "type": "screen",
                                "name": "PERSONAL_INFO"
                            },
                            "payload": {}
                        }
                    }
                ]
            }
        },
        {
            "id": "PERSONAL_INFO",
            "title": "Personal Information",
            "terminal": false,
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Personal Information"
                    },
                    {
                        "type": "TextSubheading",
                        "text": "Section 1 of 5 — Tell us about yourself"
                    },
                    {
                        "type": "Form",
                        "name": "personal_info_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "label": "Full Name (per ID)",
                                "input-type": "text",
                                "required": true,
                                "name": "full_name",
                                "helper-text": "Enter your name exactly as it appears on your ID document",
                                "min-chars": 2,
                                "max-chars": 80
                            },
                            {
                                "type": "TextInput",
                                "label": "Identity Number",
                                "input-type": "text",
                                "required": true,
                                "name": "id_number",
                                "helper-text": "13-digit South African ID number",
                                "min-chars": 13,
                                "max-chars": 13
                            },
                            {
                                "type": "TextInput",
                                "label": "Cell Phone Number",
                                "input-type": "phone",
                                "required": true,
                                "name": "cell_phone",
                                "helper-text": "e.g. 0821234567"
                            },
                            {
                                "type": "TextInput",
                                "label": "Email Address",
                                "input-type": "email",
                                "required": false,
                                "name": "email",
                                "helper-text": "Optional — enter your email address if available"
                            },
                            {
                                "type": "RadioButtonsGroup",
                                "label": "Marital Status",
                                "required": true,
                                "name": "marital_status",
                                "data-source": [
                                    {
                                        "id": "single",
                                        "title": "Single"
                                    },
                                    {
                                        "id": "married_in_cop",
                                        "title": "Married (In COP)"
                                    },
                                    {
                                        "id": "married_out_cop",
                                        "title": "Married (Out of COP)"
                                    },
                                    {
                                        "id": "divorced",
                                        "title": "Divorced"
                                    },
                                    {
                                        "id": "widowed",
                                        "title": "Widowed"
                                    }
                                ]
                            },
                            {
                                "type": "TextInput",
                                "label": "Date Married",
                                "input-type": "text",
                                "required": false,
                                "name": "date_married",
                                "helper-text": "If married — enter date (DD/MM/YYYY)"
                            }
                        ]
                    },
                    {
                        "type": "Footer",
                        "label": "Continue",
                        "on-click-action": {
                            "name": "navigate",
                            "next": {
                                "type": "screen",
                                "name": "ADDRESS_INFO"
                            },
                            "payload": {
                                "full_name": "${form.full_name}",
                                "id_number": "${form.id_number}",
                                "cell_phone": "${form.cell_phone}",
                                "email": "${form.email}",
                                "marital_status": "${form.marital_status}",
                                "date_married": "${form.date_married}"
                            }
                        }
                    }
                ]
            }
        },
        {
            "id": "ADDRESS_INFO",
            "title": "Address & Residence",
            "terminal": false,
            "data": {
                "full_name": {
                    "type": "string",
                    "__example__": "John Doe"
                },
                "id_number": {
                    "type": "string",
                    "__example__": "0000000000000"
                },
                "cell_phone": {
                    "type": "string",
                    "__example__": "0821234567"
                },
                "email": {
                    "type": "string",
                    "__example__": "john@example.com"
                },
                "marital_status": {
                    "type": "string",
                    "__example__": "single"
                },
                "date_married": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextHeading",
                        "text": "Address & Residence"
                    },
                    {
                        "type": "TextSubheading",
                        "text": "Section 2 of 5 — Where do you live?"
                    },
                    {
                        "type": "Form",
                        "name": "address_form",
                        "children": [
                            {
                                "type": "TextArea",
                                "label": "Home Address",
                                "required": true,
                                "name": "home_address",
                                "helper-text": "Enter your full street address including suburb and city",
                                "max-length": 200
                            },
                            {
                                "type": "TextInput",
                                "label": "Period at Address",
                                "input-type": "text",
                                "required": true,
                                "name": "period_at_address",
                                "helper-text": "e.g. 2 years 3 months"
                            },
                            {
                                "type": "RadioButtonsGroup",
                                "label": "Accommodation Type",
                                "required": true,
                                "name": "accommodation_type",
                                "data-source": [
                                    {
                                        "id": "bonded",
                                        "title": "Bonded (Home Loan)"
                                    },
                                    {
                                        "id": "renting",
                                        "title": "Renting"
                                    },
                                    {
                                        "id": "own_no_bond",
                                        "title": "Owned — No Bond"
                                    },
                                    {
                                        "id": "living_with_family",
                                        "title": "Living with Family / Other"
                                    }
                                ]
                            },
                            {
                                "type": "TextInput",
                                "label": "Next of Kin Name",
                                "input-type": "text",
                                "required": true,
                                "name": "kin_full_name",
                                "helper-text": "Name & surname of someone you are NOT living with"
                            },
                            {
                                "type": "TextArea",
                                "label": "Next of Kin Address",
                                "required": true,
                                "name": "kin_address",
                                "helper-text": "Full home address of your next of kin",
                                "max-length": 200
                            },
                            {
                                "type": "TextInput",
                                "label": "Next of Kin Contact",
                                "input-type": "phone",
                                "required": true,
                                "name": "kin_contact_number",
                                "helper-text": "e.g. 0821234567"
                            }
                        ]
                    },
                    {
                        "type": "Footer",
                        "label": "Continue",
                        "on-click-action": {
                            "name": "navigate",
                            "next": {
                                "type": "screen",
                                "name": "EMPLOYMENT_INFO"
                            },
                            "payload": {
                                "full_name": "${data.full_name}",
                                "id_number": "${data.id_number}",
                                "cell_phone": "${data.cell_phone}",
                                "email": "${data.email}",
                                "marital_status": "${data.marital_status}",
                                "date_married": "${data.date_married}",
                                "home_address": "${form.home_address}",
                                "period_at_address": "${form.period_at_address}",
                                "accommodation_type": "${form.accommodation_type}",
                                "kin_full_name": "${form.kin_full_name}",
                                "kin_address": "${form.kin_address}",
                                "kin_contact_number": "${form.kin_contact_number}"
                            }
                        }
                    }
                ]
            }
        },
        {
            "id": "EMPLOYMENT_INFO",
