  "cards": [
    {
      "dot": "cyan",
      "title": "Row-level security",
      "items": [
        "user_isolation: device_id = current_setting('app.device_id')",
        "Set per-request by RlsInterceptor inside the Drizzle tx",
        "auth_users / device_sessions / password_reset_tokens excluded"
      ]
    },
    {
      "dot": "emerald",
      "title": "Consistency rules",
      "items": [
        "Offline-first — all reads from Dexie",
        "Eventual — queued writes, retried up to 5×",
        "Cascade delete on users(device_id); CAS token rotation"
      ]
    },
    {
      "dot": "rose",
      "title": "Sensitivity tiers",
      "items": [
        "Public: deviceId, routine names, task titles",
        "Sensitive: email, password_hash, refresh_token (PG, bcrypt)",
        "Critical: JWT_SECRET, DB_PASSWORD (.env only)"
      ]
    }
  ]
