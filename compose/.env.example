# ============================================================================
# Insightful — Compose stack environment template
#
# Copy this file to `./.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real .env — it contains secrets (gitignored).
# CI copies this template to .env to validate compose files in a fresh checkout.
# ============================================================================

# --- Ports (host-side bindings) ---
APP_PORT=3000
LIFEOS_NEST_PORT=4001
LIFEOS_VUE_PORT=3002
LIFEOS_DB_PORT=5434
LIFEOS_DBGUI_PORT=5435
CODESPACE_DB_PORT=5433
N8N_PORT=5678
N8N_DB_PORT=5436
ODYSSEUS_PORT=7000
OLLAMA_PORT=11434
NTFY_PORT=8091
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
SEARXNG_PORT=8080
CHROMADB_PORT=8000

# --- LifeOS ---
LIFEOS_USER=admin
LIFEOS_PASSWORD=changeme-lifeos
LIFEOS_DB=lifeos
DB_PASSWORD=changeme-db
JWT_SECRET=changeme-jwt-secret

# --- codeSpace / codespace DB ---
CODESPACE_DB_PASSWORD=changeme-codespace

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme-n8n-db
N8N_ENCRYPTION_KEY=changeme-n8n-encryption
N8N_JWT_SECRET=changeme-n8n-jwt

# --- Odysseus ---
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=changeme-odysseus

# --- OAuth2 / Google ---
OAUTH2_COOKIE_SECRET=changeme-oauth2-cookie
OAUTH2_GOOGLE_CLIENT_ID=0000-google-client-id
OAUTH2_GOOGLE_CLIENT_SECRET=changeme-google-client-secret

# --- AI API keys (external) ---
GEMINI_API_KEY=changeme-gemini
OPENAI_API_KEY=changeme-openai
LLM_HOST=http://127.0.0.1:11434
